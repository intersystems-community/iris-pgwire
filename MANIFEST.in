# Include everything from the project root by default
include *.in
include *.json
include *.key
include *.md
include *.py
include *.sql
include *.svg
include *.txt
include .bumpversion.cfg
include pytest.ini
include .bandit
include .mcp.json

# Include important directories
recursive-include docs *.md
recursive-include docs *.yaml
recursive-include examples *.bak
recursive-include examples *.csv
recursive-include examples *.js
recursive-include examples *.json
recursive-include examples *.md
recursive-include examples *.prisma
recursive-include examples *.py
recursive-include examples *.sh
recursive-include examples *.sql
recursive-include examples *.yml
recursive-include ipm *.cls
recursive-include ipm *.txt
recursive-include ipm *.xml
recursive-include scripts *.md
recursive-include scripts *.py
recursive-include scripts *.sh

# Include all source files
recursive-include src *.py

# Exclude build artifacts and cache
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.so
global-exclude *.dylib

# Exclude internal/git files
exclude .gitignore
exclude .gitlab-ci.yml
exclude .dockerignore
prune .git
prune .github
prune .claude
prune .specify
prune .opencode

