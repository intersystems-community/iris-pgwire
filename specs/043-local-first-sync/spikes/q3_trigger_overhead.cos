 // Q3 -- What does an outbox trigger cost on the write path?
 //
 // Run in: USER namespace
 // Budget: the project constitution caps query translation overhead at 5 ms.
 // The outbox trigger must sit well inside that, since it is additive to it.
 //
 // Measures two identical tables, one with an AFTER INSERT trigger writing to
 // ^PGWireSync.Log, and reports the per-row delta.
 //
 new rs,st,sc,i,t0,elA,elB,perA,perB,delta,ROWS,verdict,note,e,trigOK
 set ROWS = %%ROWS%%
 set verdict = "INCONCLUSIVE", note = "probe did not complete", trigOK = 0
 //
 write !,"Q3.1 setup -- two tables, one with an outbox trigger",!
 set rs = ##class(%SQL.Statement).%ExecDirect(,"DROP TABLE SQLUser.SpikeQ3A")
 set rs = ##class(%SQL.Statement).%ExecDirect(,"DROP TABLE SQLUser.SpikeQ3B")
 kill ^PGWireSync.Log, ^PGWireSync.Seq
 //
 set rs = ##class(%SQL.Statement).%ExecDirect(,"CREATE TABLE SQLUser.SpikeQ3A (id INT PRIMARY KEY, payload VARCHAR(100))")
 if rs.%SQLCODE < 0 {
   write "  create A failed: ",rs.%SQLCODE," ",rs.%Message,!
   write !,"Q3 VERDICT: INCONCLUSIVE -- could not create baseline table",!
   quit
 }
 set rs = ##class(%SQL.Statement).%ExecDirect(,"CREATE TABLE SQLUser.SpikeQ3B (id INT PRIMARY KEY, payload VARCHAR(100))")
 if rs.%SQLCODE < 0 {
   write "  create B failed: ",rs.%SQLCODE," ",rs.%Message,!
   write !,"Q3 VERDICT: INCONCLUSIVE -- could not create trigger table",!
   quit
 }
 write "  tables created",!
 //
 // The outbox trigger: sequence via $INCREMENT, payload as $LISTBUILD.
 // {id} is IRIS trigger syntax for the inserted column value.
 set sc = "CREATE TRIGGER SpikeQ3BOutbox AFTER INSERT ON SQLUser.SpikeQ3B "
 set sc = sc_"FOR EACH ROW LANGUAGE OBJECTSCRIPT "
 set sc = sc_"BEGIN "
 set sc = sc_"SET ^PGWireSync.Log($INCREMENT(^PGWireSync.Seq)) = $LISTBUILD(""SpikeQ3B"",""insert"",{id}) "
 set sc = sc_"END"
 set rs = ##class(%SQL.Statement).%ExecDirect(,sc)
 if rs.%SQLCODE < 0 {
   write "  CREATE TRIGGER failed: SQLCODE=",rs.%SQLCODE," ",rs.%Message,!
   write "  (check IRIS trigger syntax for this version before recording a result)",!
   write !,"Q3 VERDICT: INCONCLUSIVE -- trigger could not be created",!
   quit
 }
 set trigOK = 1
 write "  trigger created",!
 //
 write !,"Q3.2 baseline -- ",ROWS," inserts, no trigger",!
 set st = ##class(%SQL.Statement).%New()
 set sc = st.%Prepare("INSERT INTO SQLUser.SpikeQ3A (id,payload) VALUES (?,?)")
 if '$system.Status.IsOK(sc) {
   write "  prepare failed: ",$system.Status.GetErrorText(sc),!
   write !,"Q3 VERDICT: INCONCLUSIVE -- could not prepare baseline insert",!
   quit
 }
 set t0 = $zh
 for i = 1:1:ROWS { set rs = st.%Execute(i,"payload-"_i) }
 set elA = $zh - t0
 write "  ",ROWS," rows in ",$fnumber(elA,"",3),"s",!
 //
 write !,"Q3.3 with outbox trigger -- ",ROWS," inserts",!
 set st = ##class(%SQL.Statement).%New()
 set sc = st.%Prepare("INSERT INTO SQLUser.SpikeQ3B (id,payload) VALUES (?,?)")
 if '$system.Status.IsOK(sc) {
   write "  prepare failed: ",$system.Status.GetErrorText(sc),!
   write !,"Q3 VERDICT: INCONCLUSIVE -- could not prepare trigger insert",!
   quit
 }
 set t0 = $zh
 for i = 1:1:ROWS { set rs = st.%Execute(i,"payload-"_i) }
 set elB = $zh - t0
 write "  ",ROWS," rows in ",$fnumber(elB,"",3),"s",!
 //
 write !,"Q3.4 verify the outbox actually captured the writes",!
 write "  ^PGWireSync.Seq = ",$get(^PGWireSync.Seq,0),!
 if $get(^PGWireSync.Seq,0) '= ROWS {
   write "  >> outbox row count does not match insert count -- trigger is not firing on every row",!
 }
 //
 write !,"Q3.5 result",!
 set perA = (elA / ROWS) * 1000
 set perB = (elB / ROWS) * 1000
 set delta = perB - perA
 write "  baseline    : ",$fnumber(perA,"",4)," ms/row",!
 write "  with outbox : ",$fnumber(perB,"",4)," ms/row",!
 write "  delta       : ",$fnumber(delta,"",4)," ms/row",!
 write "  budget      : 5.0000 ms (constitutional, for translation overhead)",!
 //
 if delta < 0.5 {
   set verdict = "PASS", note = "trigger costs "_$fnumber(delta,"",4)_" ms/row, comfortably inside budget"
 } elseif delta < 5 {
   set verdict = "PASS", note = "trigger costs "_$fnumber(delta,"",4)_" ms/row, inside budget but material -- watch on hot tables"
 } else {
   set verdict = "FAIL", note = "trigger costs "_$fnumber(delta,"",4)_" ms/row, at or over the 5 ms budget"
 }
 //
 if %%KEEP%% = 0 {
   set rs = ##class(%SQL.Statement).%ExecDirect(,"DROP TABLE SQLUser.SpikeQ3A")
   set rs = ##class(%SQL.Statement).%ExecDirect(,"DROP TABLE SQLUser.SpikeQ3B")
   kill ^PGWireSync.Log, ^PGWireSync.Seq
   write !,"  (test tables and outbox globals removed)",!
 }
 write !,"Q3 VERDICT: ",verdict," -- ",note,!
